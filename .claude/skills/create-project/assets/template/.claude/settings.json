{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "NotebookEdit",
      "Bash",
      "PowerShell"
    ],
    "deny": [
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(python -m pip install:*)",
      "Bash(python3 -m pip install:*)",
      "Bash(pip install --user:*)",
      "Bash(uv pip install --system:*)",
      "PowerShell(pip install:*)",
      "PowerShell(pip3 install:*)",
      "PowerShell(python -m pip install:*)",
      "PowerShell(python3 -m pip install:*)",
      "PowerShell(pip install --user:*)",
      "PowerShell(uv pip install --system:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(unlink:*)",
      "Bash(shred:*)",
      "Bash(truncate:*)",
      "Bash(git clean:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(ftp:*)",
      "Bash(telnet:*)",
      "Bash(npm install -g:*)",
      "Bash(npm i -g:*)",
      "Bash(pnpm add -g:*)",
      "Bash(yarn global:*)",
      "Bash(brew install:*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(choco install:*)",
      "Bash(winget install:*)",
      "Bash(pipx:*)",
      "Bash(conda install:*)",
      "Bash(gem install:*)",
      "Bash(cargo install:*)",
      "Bash(go install:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(del:*)",
      "PowerShell(Clear-Content:*)",
      "PowerShell(Invoke-WebRequest:*)",
      "PowerShell(Invoke-RestMethod:*)",
      "PowerShell(npm install -g:*)",
      "PowerShell(npm i -g:*)",
      "PowerShell(pnpm add -g:*)",
      "PowerShell(yarn global:*)",
      "PowerShell(choco install:*)",
      "PowerShell(winget install:*)",
      "PowerShell(pipx:*)",
      "PowerShell(conda install:*)",
      "PowerShell(gem install:*)",
      "PowerShell(cargo install:*)",
      "PowerShell(go install:*)"
    ]
  }
}
